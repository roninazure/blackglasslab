# BlackGlassLab — config template
# Copy to .env and edit:
#   cp .env.example .env

# --- Runtime mode ---
BGL_MODE=paper                  # paper|live
BGL_SOURCE=fake                 # fake|polymarket|kalshi

# --- Database / paths ---
BGL_DB_PATH=memory/runs.sqlite
BGL_LOG_DIR=logs
BGL_SIGNALS_DIR=signals
BGL_REPORT_DIR=reports
BGL_EXPORT_DIR=data
BGL_BACKUP_DIR=backups
BGL_RUNTIME_DIR=runtime
BGL_WATCHLIST_PATH=markets/polymarket_watchlist.json
BGL_RUNTIME_ENV_FILE=.env.runtime
# compatibility keeps relative checkout defaults; production requires absolute overrides
BGL_RUNTIME_MODE=compatibility
BGL_PRODUCTION_MODE=0

# --- Phase 3 loop engine budgets ---
BGL_ACTIVE_UNIVERSE_SIZE=75
BGL_EVALUATIONS_PER_CYCLE=15
# Scan a wider batch so policy/quality rejects do not consume evaluation slots.
BGL_INFER_BATCH=30
BGL_MAX_LLM_CALLS_PER_CYCLE=3
BGL_MAX_SKEPTIC_CALLS_PER_CYCLE=1
BGL_MAX_DAILY_LLM_CALLS=24
BGL_CANDIDATE_THRESHOLD_FOR_SKEPTIC=0.040
BGL_MIN_OPPORTUNITY_SCORE_FOR_LLM=55
# Optional; leave 0 when provider cost is not configured.
BGL_ESTIMATED_COST_PER_CALL_USD=0
BGL_SHADOW_THRESHOLD_BUCKETS=0.02,0.03,0.04,0.05
BGL_TIME_TO_RESOLUTION_WEIGHT=1.0
BGL_SHADOW_LEDGER_ENABLED=1
SWARM_EDGE_PUBLISH_ENABLED=0    # 0=local-only exports, 1=allow git commit/push
SWARM_EDGE_WATCHLIST_APPLY=0    # 0=watchlist refresh stays read-only in run_live.sh

# --- Institutional market universe ---
BGL_MARKET_UNIVERSE_POLICY_MODE=institutional_v2
# Backward-compatible alias; BGL_ACTIVE_UNIVERSE_SIZE takes precedence.
BGL_UNIVERSE_TARGET_SIZE=75
BGL_UNIVERSE_MAX_PAGES=8
BGL_UNIVERSE_MAX_CANDIDATES=5000
BGL_UNIVERSE_SORT_MODES=volume24hr,volume,liquidity,endDate
BGL_UNIVERSE_CATEGORY_HINTS=
BGL_UNIVERSE_CORE_MIN_LIQUIDITY=25000
BGL_UNIVERSE_CORE_MIN_VOLUME=250000
BGL_UNIVERSE_CORE_MAX_SPREAD=0.02
BGL_UNIVERSE_CORE_MIN_PROBABILITY=0.05
BGL_UNIVERSE_CORE_MAX_PROBABILITY=0.95
BGL_UNIVERSE_CORE_MIN_QUALITY_SCORE=75
BGL_UNIVERSE_RESEARCH_MIN_LIQUIDITY=5000
BGL_UNIVERSE_RESEARCH_MIN_VOLUME=50000
BGL_UNIVERSE_RESEARCH_MAX_SPREAD=0.04
BGL_UNIVERSE_RESEARCH_MIN_PROBABILITY=0.025
BGL_UNIVERSE_RESEARCH_MAX_PROBABILITY=0.975
BGL_UNIVERSE_RESEARCH_MIN_QUALITY_SCORE=55
BGL_UNIVERSE_MAX_PER_CATEGORY=4
BGL_UNIVERSE_MAX_PER_EVENT=2
BGL_UNIVERSE_MIN_DAYS_TO_RESOLUTION=2
BGL_UNIVERSE_MAX_DAYS_TO_RESOLUTION=365
BGL_UNIVERSE_REQUIRE_DEADLINE=1
BGL_UNIVERSE_ALLOW_SPORTS=0
BGL_UNIVERSE_ALLOW_THIN_PRIMARIES=0
BGL_UNIVERSE_INCLUDE_WATCH=0

# --- Risk controls (production guardrails) ---
BGL_MIN_EDGE=0.04               # production threshold; shadow buckets may be lower
BGL_MAX_DISAGREEMENT=0.25       # max arbiter disagreement allowed
BGL_MAX_BRIER=0.30              # block if model calibration looks bad
BGL_MAX_DAILY_TRADES=10
BGL_MAX_POSITION_USD=50         # hard cap per trade (paper/live)
BGL_BASE_BET_USD=10             # default sizing base
BGL_STOP_AFTER_LOSS_STREAK=3

# --- Evolution / swarm tuning (optional) ---
BGL_K_OP=3
BGL_K_SK=3
BGL_EVOLVE_INTERVAL=50
BGL_EVOLVE_WINDOW=600
BGL_EVOLVE_MIN_OBS=10
BGL_EVOLVE_KEEP=8
BGL_EVOLVE_SPAWN=8

# --- API keys (leave blank in repo; set in .env only) ---
POLYMARKET_API_KEY=
KALSHI_API_KEY=
KALSHI_API_SECRET=

# --- LLM / Claude (Phase 3) ---
ANTHROPIC_API_KEY=                  # Required for Phase 3 LLM reasoning
BGL_INFER_USE_LLM=1                 # 1=Claude reasoning, 0=baseline heuristic only
BGL_LLM_PROVIDER=anthropic          # anthropic (Claude) only
BGL_LLM_MODEL=claude-haiku-4-5-20251001  # Fast+cheap for infer loop; upgrade to claude-sonnet-4-6 for max edge
