#!/bin/bash
set -euo pipefail

# The wrapper is a client of the launchd job, never a second process
# supervisor.  It intentionally does not use PID files or broad process
# matching to determine ownership.
resolve_wrapper_path() {
  local source="${BASH_SOURCE[0]}"
  local source_dir
  while [[ -L "$source" ]]; do
    source_dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" = /* ]] || source="$source_dir/$source"
  done
  printf '%s\n' "$source"
}

WRAPPER_PATH="$(resolve_wrapper_path)"
WRAPPER_DIR="$(cd -P "$(dirname "$WRAPPER_PATH")" && pwd)"
WRAPPER_ROOT="$(cd -P "$WRAPPER_DIR/.." && pwd)"

# The installed runtime-level wrapper is deliberately only a forwarding
# entrypoint.  Keeping the command table in the active release means new
# release commands become available without synchronizing another wrapper.
if [[ -e "$WRAPPER_ROOT/current/bin/swarm-edge" && "$WRAPPER_PATH" != "$WRAPPER_ROOT/current/bin/swarm-edge" ]]; then
  exec "$WRAPPER_ROOT/current/bin/swarm-edge" "$@"
fi

# An installed wrapper lives at <runtime>/bin/swarm-edge and always executes
# from <runtime>/current. SWARM_EDGE_ROOT may point either at that current
# release or at a runtime root containing the current pointer. A checkout-local
# wrapper remains usable for development, but no path depends on the user home
# directory or caller working directory.
if [[ -n "${SWARM_EDGE_ROOT:-}" ]]; then
  RELEASE_PATH="$SWARM_EDGE_ROOT"
  [[ -e "$RELEASE_PATH/current" ]] && RELEASE_PATH="$RELEASE_PATH/current"
elif [[ -e "$WRAPPER_ROOT/current" ]]; then
  RELEASE_PATH="$WRAPPER_ROOT/current"
else
  RELEASE_PATH="$WRAPPER_ROOT"
fi
APP_DIR="$(cd -P "$RELEASE_PATH" && pwd)"

# Releases are immutable.  Their interpreter is owned by the runtime, not by
# the release directory.  Resolve the runtime root from the active pointer or
# from the conventional releases/<sha> layout used by direct release calls.
if [[ -n "${SWARM_EDGE_ROOT:-}" ]]; then
  if [[ "$(basename "$SWARM_EDGE_ROOT")" == "current" ]]; then
    RUNTIME_ROOT="$(cd -P "$(dirname "$SWARM_EDGE_ROOT")" && pwd)"
  elif [[ -e "$SWARM_EDGE_ROOT/current" ]]; then
    RUNTIME_ROOT="$(cd -P "$SWARM_EDGE_ROOT" && pwd)"
  else
    RUNTIME_ROOT="$(cd -P "$(dirname "$(dirname "$APP_DIR")")" && pwd)"
  fi
elif [[ "$(basename "$(dirname "$WRAPPER_ROOT")")" == "releases" ]]; then
  RUNTIME_ROOT="$(cd -P "$WRAPPER_ROOT/../.." && pwd)"
else
  RUNTIME_ROOT="$WRAPPER_ROOT"
fi
RELEASE_SHA="$(basename "$APP_DIR")"

if [[ -n "${BGL_RUNTIME_ENV_FILE:-}" ]]; then
  DEFAULT_ENV_FILE="$BGL_RUNTIME_ENV_FILE"
elif [[ -f "$WRAPPER_ROOT/config/runtime.env" ]]; then
  DEFAULT_ENV_FILE="$WRAPPER_ROOT/config/runtime.env"
elif [[ -f "$RUNTIME_ROOT/config/runtime.env" ]]; then
  DEFAULT_ENV_FILE="$RUNTIME_ROOT/config/runtime.env"
else
  DEFAULT_ENV_FILE="$APP_DIR/.env.runtime"
fi
LABEL="${SWARM_EDGE_LAUNCHD_LABEL:-com.swarmedge.runner}"
DOMAIN="${SWARM_EDGE_LAUNCHD_DOMAIN:-gui/$(id -u)}"
JOB="$DOMAIN/$LABEL"

load_env() {
  local env_file="$DEFAULT_ENV_FILE"
  [[ -f "$env_file" ]] || env_file="$APP_DIR/.env"
  [[ -f "$env_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
    local key="${line%%=*}"
    local value="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    if [[ "$value" == \"*\" && "$value" == *\" ]] || [[ "$value" == \'*\' && "$value" == *\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    export "$key=$value"
  done < "$env_file"
}

resolve_python() {
  if [[ -n "${PYTHON_BIN:-}" ]]; then
    [[ "$PYTHON_BIN" = /* && -x "$PYTHON_BIN" ]] || {
      echo "Invalid PYTHON_BIN (must be an executable absolute path): $PYTHON_BIN" >&2
      exit 78
    }
  else
    PYTHON_BIN="$RUNTIME_ROOT/venvs/$RELEASE_SHA/bin/python"
  fi
  [[ -x "$PYTHON_BIN" ]] || {
    echo "Missing SHA-matched external Python: $PYTHON_BIN" >&2
    exit 78
  }
  export PYTHON_BIN
}

job_print() {
  launchctl print "$JOB"
}

case "${1:-status}" in
  start)
    load_env
    launchctl kickstart "$JOB"
    ;;

  stop)
    launchctl kill SIGTERM "$JOB"
    ;;

  restart)
    launchctl kickstart -k "$JOB"
    ;;

  status)
    load_env
    if ! job_print; then
      echo "Swarm Edge launchd job is not loaded: $JOB" >&2
      exit 1
    fi
    ;;

  run)
    # The launchd template sets this marker.  The parent check preserves the
    # existing plist's compatibility while rejecting shell-started runners.
    parent_comm="$(ps -p "$PPID" -o comm= 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "${SWARM_EDGE_LAUNCHD_RUN:-0}" != "1" && "$parent_comm" != "launchd" && "$parent_comm" != "/sbin/launchd" ]]; then
      echo "Refusing unmanaged runner start; use: $0 start" >&2
      exit 64
    fi
    load_env
    resolve_python
    exec "$APP_DIR/scripts/run_live.sh"
    ;;

  logs)
    load_env
    exec tail -f "${BGL_LOG_DIR:-$APP_DIR/logs}/infer_loop.log"
    ;;

  tail)
    load_env
    exec tail -80 "${BGL_LOG_DIR:-$APP_DIR/logs}/infer_loop.log"
    ;;

  infer)
    load_env
    resolve_python
    exec "$PYTHON_BIN" "$APP_DIR/live_runner.py" --infer
    ;;

  resolve)
    load_env
    resolve_python
    exec "$PYTHON_BIN" "$APP_DIR/scripts/resolve_paper_trades.py" --dry-run
    ;;

  watch|portfolio|positions|revenue-status|discovery-breakdown|alpha-leaderboard)
    command="$1"
    shift
    load_env
    resolve_python
    exec "$PYTHON_BIN" "$APP_DIR/scripts/operator_console.py" "$command" "$@"
    ;;

  backup)
    echo "Backups are a deployment operation; use the release tooling." >&2
    exit 64
    ;;

  ps)
    echo "Use '$0 status' to inspect $JOB; launchd is the sole lifecycle authority." >&2
    exec launchctl print "$JOB"
    ;;

  *)
    echo "Usage: swarm-edge {start|run|stop|restart|status|ps|logs|tail|infer|resolve|watch|portfolio|positions|revenue-status|discovery-breakdown|alpha-leaderboard}" >&2
    exit 1
    ;;
esac
