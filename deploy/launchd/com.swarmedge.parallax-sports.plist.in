<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.swarmedge.parallax-sports</string>
  <key>ProgramArguments</key>
  <array>
    <string>@SWARM_EDGE_PYTHON@</string>
    <string>@SWARM_EDGE_ROOT@/scripts/parallax_unattended.py</string>
    <string>--root</string>
    <string>@SWARM_EDGE_ROOT@</string>
    <string>--state-dir</string>
    <string>@PARALLAX_STATE_DIR@</string>
    <string>--runtime-env</string>
    <string>@BGL_RUNTIME_ENV_FILE@</string>
    <string>--interval-seconds</string>
    <string>300</string>
  </array>
  <key>UserName</key>
  <string>scottsteele</string>
  <key>WorkingDirectory</key>
  <string>@SWARM_EDGE_ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/scottsteele</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PARALLAX_RELEASE_SHA</key>
    <string>@RELEASE_SHA@</string>
    <key>PYTHONPATH</key>
    <string>@SWARM_EDGE_ROOT@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@SWARM_EDGE_LOG_DIR@/parallax-sports.log</string>
  <key>StandardErrorPath</key>
  <string>@SWARM_EDGE_LOG_DIR@/parallax-sports.err.log</string>
</dict>
</plist>
